{
  "name": "mcp-playground-server",
  "version": "2.0.0",
  "description": "MCP server exposing live kafka-docker-playground state: environment status, connector health, filtered container logs and example discovery",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-playground-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "fastmcp:dev": "npx fastmcp dev src/index.ts",
    "fastmcp:inspect": "npx fastmcp inspect src/index.ts"
  },
  "dependencies": {
    "fastmcp": "^3.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "mcp",
    "kafka",
    "docker",
    "connect",
    "playground",
    "confluent"
  ],
  "author": "Vincent Saboulin",
  "license": "MIT"
}
